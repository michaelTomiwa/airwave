# Copy this file to .env and fill in real values for local dev.

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- LiveKit (self-hosted via docker-compose.yml) ---
LIVEKIT_URL="http://localhost:7880"
NEXT_PUBLIC_LIVEKIT_WS_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret1234567890devsecret"

# --- Paystack (https://dashboard.paystack.com/#/settings/developers) ---
PAYSTACK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# --- Recording storage (optional) ---
# LiveKit Cloud's Egress service has no local disk — it needs an S3-compatible
# bucket to write recordings to. Without these, broadcasting/chat/tips/etc all
# still work fully; only automatic recording is skipped. Any S3-compatible
# provider works (Cloudflare R2 has a generous free tier and needs no card).
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# --- App ---
APP_URL="http://localhost:3000"
